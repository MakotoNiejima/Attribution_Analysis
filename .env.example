# MySQL（不要把真实 .env 提交到版本库）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-a-local-password
DB_NAME=attribution_db

# LLM
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 文档检索：默认 NumPy 在 macOS/Windows/Linux 上都可稳定运行。
# 只有确认本机 FAISS wheel 兼容时才改为 faiss。
RAG_VECTOR_BACKEND=numpy

# 演示数据对比窗口
BASELINE_START=2026-06-01 00:00:00
BASELINE_END=2026-06-15 00:00:00
CURRENT_START=2026-07-01 00:00:00
CURRENT_END=2026-07-15 00:00:00

# 工作台
FRONTEND_URL=http://localhost:5174
AUTH_REQUIRED=false
AUTH_SECRET=replace-with-a-long-random-secret-before-production
DEV_DEFAULT_USERNAME=local-analyst
DEV_DEFAULT_ROLE=analyst
